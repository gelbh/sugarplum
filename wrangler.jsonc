/**
 * Sugarplum Worker config.
 * Binding IDs below are placeholders until `wrangler` create succeeds against a Cloudflare account.
 * Secrets (set via `wrangler secret put`): SECRETS_WRAP_KEY,
 * R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, DOCLING_API_KEY (when DOCLING_URL is set),
 * TURNSTILE_SECRET_KEY (email register/login Siteverify),
 * UNSPLASH_ACCESS_KEY, ADMIN_EMAILS, ANATOMY_VIEWER_EMAILS
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sugarplum",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-26",
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"] }],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
    "issues": {
      "enabled": true,
    },
  },
  // DOCLING_URL: optional. Local compose or prod HTTPS host. When set, DOCLING_API_KEY secret is required (X-Api-Key).
  "vars": {
    "APP_URL": "https://sugarplum.gelbhart.dev",
    "R2_ACCOUNT_ID": "578279c4ee8d8a1b0bda8ecf8ecc3f67",
    "R2_BUCKET_NAME": "sugarplum-materials",
    // Turnstile managed widget "sugarplum auth" (domains: sugarplum.gelbhart.dev)
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFrtuD0lpyFM8Tom",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sugarplum",
      "database_id": "737d7509-0390-4715-b52a-8ecf18e6cb45",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MATERIALS",
      "bucket_name": "sugarplum-materials",
      // Browser uploads go to real R2 via presigned URLs; local Miniflare R2
      // would not see those objects, so generation fails with "R2 object missing".
      "remote": true,
    },
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "4b51ba56cbdd48bd97a31ff775a9e684",
    },
    {
      "binding": "CACHE",
      "id": "782df54519e4490fb18479c52eca5f51",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "workflows": [
    {
      "name": "sugarplum-generation",
      "binding": "GENERATION_WORKFLOW",
      "class_name": "GenerationWorkflow",
    },
    {
      "name": "sugarplum-fill-all",
      "binding": "FILL_ALL_WORKFLOW",
      "class_name": "FillAllWorkflow",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GENERATION_SLOTS",
        "class_name": "GenerationSlotDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-generation-slots",
      "new_sqlite_classes": ["GenerationSlotDO"],
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "GENERATE_QUEUE",
        "queue": "sugarplum-generate",
      },
      {
        "binding": "CARD_REGEN_QUEUE",
        "queue": "sugarplum-card-regen",
      },
      {
        "binding": "EXPORT_QUEUE",
        "queue": "sugarplum-export",
      },
    ],
    "consumers": [
      {
        "queue": "sugarplum-generate",
        "max_batch_size": 1,
        // 2 is the locked modest ceiling from the queue-responsiveness design
        "max_concurrency": 2,
        // Keep in sync with GENERATE_QUEUE_* in worker/generation/progress.ts
        "max_retries": 21,
        "retry_delay": 60,
      },
      {
        "queue": "sugarplum-card-regen",
        "max_batch_size": 1,
        // 2C: omit max_concurrency so Cloudflare autoscales
        // Keep in sync with CARD_REGEN_QUEUE_* in worker/generation/card-regen-op.ts
        "max_retries": 21,
        "retry_delay": 60,
      },
      {
        "queue": "sugarplum-export",
        "max_batch_size": 1,
        "max_concurrency": 1,
        // Keep in sync with EXPORT_QUEUE_* in worker/export/stale.ts
        "max_retries": 11,
        "retry_delay": 30,
      },
    ],
  },
  "triggers": {
    // Daily FSRS mark batch; every 5m soft-completes/fails stale generation jobs.
    "crons": ["0 6 * * *", "*/5 * * * *"],
  },
}
