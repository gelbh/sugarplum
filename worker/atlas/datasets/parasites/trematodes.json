          },
          {
            "name": "metacercaria",
            "location": "aquatic vegetation",
            "hostRole": "environment",
            "infective": true,
            "transmission": "encysts on aquatic vegetation",
            "note": "Infective stage for the definitive host"
          },
          {
            "name": "immature fluke",
            "location": "liver parenchyma",
            "hostRole": "definitive",
            "transmission": "ingested on vegetation"
          },
          {
            "name": "adult fluke",
