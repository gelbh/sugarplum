{
  "entry": "npm run db:seed:local -- --targets=<targets>",
  "baseline": "base",
  "surfaces": [
    {
      "id": "auth-deck",
      "targets": ["base"],
      "match": {
        "keywords": ["sign-in", "atlas", "deck", "auth"],
        "paths": ["worker/auth/**"]
      }
    },
    {
      "id": "insights",
      "targets": ["base", "insights"],
      "match": {
        "keywords": ["insights"],
        "paths": [
          "**/insights/**",
          "src/routes/InsightsPage.tsx",
          "src/api/insights.ts",
          "src/guest/insights.ts"
        ]
      }
    },
    {
      "id": "orchard-overview",
      "targets": ["base", "orchard"],
      "match": {
        "keywords": ["orchard", "leaderboard", "daily goal"],
        "paths": [
          "src/achievements/**",
          "worker/gamification/**",
          "src/routes/AchievementsPage.tsx"
        ]
      }
    },
    {
      "id": "deck-hygiene",
      "targets": ["base", "hygiene"],
      "match": {
        "keywords": ["hygiene", "essay back", "compound front"],
        "paths": ["**/hygiene/**", "worker/generation/deck-hygiene.ts"]
      }
    }
  ]
}
