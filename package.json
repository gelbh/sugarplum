    "@open-spaced-repetition/binding": "^0.6.0",
    "@open-spaced-repetition/binding-wasm32-wasip1": "^0.6.0",
    "aws4fetch": "^1.0.20",
    "hono": "^4.9.12",
    "jszip": "^3.10.2",
    "onnxruntime-web": "^1.31.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sql.js": "^1.15.2",
    "tesseract.js": "^7.0.0",
