{
  "name": "sugarplum",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetch-layout-assets.mjs && node scripts/fetch-ocr-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "npm run test:client && npm run test:worker",
    "test:client": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "check:boundaries": "node scripts/check-module-boundaries.mjs",
    "check:asset-size": "node scripts/checkWorkersAssetSize.mjs public",
    "eval:live": "vitest run --config vitest.live.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply sugarplum --local",
    "db:seed:local": "node scripts/seed-local.mjs",
    "generate:problem-html": "node scripts/generate-problem-html.mjs",
    "check:problem-html": "node scripts/generate-problem-html.mjs --check"
  },
  "dependencies": {
    "@embedpdf/engine": "^3.2.0",
    "@embedpdf/react": "^3.2.0",
    "@emnapi/core": "^2.0.0-beta.3",
    "@emnapi/runtime": "^2.0.0-beta.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@open-spaced-repetition/binding-wasm32-wasip1": "^0.6.1",
    "@silurus/ooxml": "^0.89.9",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.18",
    "jszip": "^3.10.2",
    "onnxruntime-web": "^1.31.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-simple-maps": "^5.0.5",
    "recharts": "^3.10.1",
    "sql.js": "^1.16.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.18",
    "ts-fsrs": "^6.0.0",
    "unpdf": "^1.9.1",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.6"
  },
  "//": "overrides.minimatch: Dependabot alert #11 (DoS via globparts) from workbox/glob; remove when vite-plugin-pwa tree ships >=11",
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
    "@cloudflare/vitest-plugin": "^1.9.1",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.187.0",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "meshoptimizer": "^1.3.0",
    "sharp": "0.35.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.165.0",
    "yaml": "^2.9.1"
  }
}
